# pnew — tool state pinned inside ./.cache (direnv). Shared download caches
# (uv/npm) stay on the SSD via ~/.zshenv; nothing lands on the internal disk.
export RUFF_CACHE_DIR="$PWD/.cache/ruff"
export MYPY_CACHE_DIR="$PWD/.cache/mypy"
export HYPOTHESIS_STORAGE_DIRECTORY="$PWD/.cache/hypothesis"
export PRE_COMMIT_HOME="$PWD/.cache/pre-commit"
export PYTHONPYCACHEPREFIX="$PWD/.cache/pycache"
export XDG_CACHE_HOME="$PWD/.cache/xdg"
